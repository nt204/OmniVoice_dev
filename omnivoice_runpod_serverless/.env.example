# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=omnivoice_web
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Roles
OMNIVOICE_ADMIN_USER=omnivoice_admin
OMNIVOICE_ADMIN_PASSWORD=admin_password_123
OMNIVOICE_VIEWER_USER=omnivoice_viewer
OMNIVOICE_VIEWER_PASSWORD=viewer_password_123

# Web Configuration
WEB_PORT=7860
DATABASE_URL=postgresql+psycopg://${OMNIVOICE_ADMIN_USER}:${OMNIVOICE_ADMIN_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
JWT_SECRET=generate_a_random_hex_string_here

# RunPod Configuration
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id
RUNPOD_API_KEY=your_runpod_api_key

# Pricing Configuration (Model A: Audio Duration)
PRICING_VERSION=v2-audio-duration
PRICING_RATE_PER_SECOND=0.00019
PRICING_FIXED_FEE=0.0005
